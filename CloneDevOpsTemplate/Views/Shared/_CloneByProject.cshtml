@model CloneFormViewModel<ProjectBase>
@{
    var operationId = Guid.NewGuid();
}

@Html.ValidationSummary(false, "", new { @class = "text-danger" })

@using (Html.BeginForm(Model.Action, Model.Controller, FormMethod.Post, new { @class = "form-container-clone input-group-lg", id = "cloneForm" }))
{
    @Html.Hidden("operationId", operationId)
    <div class="form-group row">
        @Html.Label("templateProjectId", "Select a source project", new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.DropDownList("templateProjectId", new SelectList(Model.Items, "Id", "Name"), "Select a project", new { @class = "form-select form-control" })
        </div>
    </div>
    
    <div class="form-group row">
        @Html.Label("newProjectName", "Select a target project", new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.DropDownList("projectId", new SelectList(Model.Items, "Id", "Name"), "Select a project", new { @class = "form-select form-control" })
        </div>
    </div>
    
    <div class="form-group row">
        <label for="cloneButton" class="col-sm-2 col-form-label form-hidden-label">Create</label>
        <div class="col-sm-10">
            <button id="cloneButton" type="submit" class="btn btn-primary form-button form-text">Clone</button>
        </div>
    </div>
}

@{ await Html.RenderPartialAsync("_MigrationProgress", new MigrationProgressPanelViewModel(operationId, "cloneForm", "cloneButton", Model.FinishedMigration)); }
