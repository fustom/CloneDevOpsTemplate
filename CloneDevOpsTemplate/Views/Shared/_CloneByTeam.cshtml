@model CloneFormViewModel<Team>
@{
    var operationId = Guid.NewGuid();
}

<script>
    var model = @Html.Raw(Json.Serialize(Model.Items));

    function onTeamChanged()
    {
        let templateProjectId = model.find(i => i.id == templateTeamId.value).projectId;
        $('#templateProjectId').val(templateProjectId);
        let projectId = model.find(i => i.id == projectTeamId.value).projectId;
        $('#projectId').val(projectId);
    }
</script>

@Html.ValidationSummary(false, "", new { @class = "text-danger" })

@using (Html.BeginForm(Model.Action, Model.Controller, FormMethod.Post, new { @class = "form-container-clone input-group-lg", id = "cloneForm" }))
{
    @Html.Hidden("operationId", operationId)
    @Html.Hidden("templateProjectId")
    @Html.Hidden("projectId")
    
    <div class="form-group row">
        @Html.Label("templateProjectId", "Select a source team", new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.DropDownList("templateTeamId", new SelectList(Model.Items, "Id", "Name"), "Select a team", new { @class = "form-select form-control", @onChange = "onTeamChanged()" })
        </div>
    </div>
    
    <div class="form-group row">
        @Html.Label("newProjectName", "Select a target team", new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.DropDownList("projectTeamId", new SelectList(Model.Items, "Id", "Name"), "Select a team", new { @class = "form-select form-control", @onChange = "onTeamChanged()" })
        </div>
    </div>
    
    <div class="form-group row">
        <label for="cloneButton" class="col-sm-2 col-form-label form-hidden-label">Create</label>
        <div class="col-sm-10">
            <button id="cloneButton" type="submit" class="btn btn-primary form-button form-text">Clone</button>
        </div>
    </div>
}

@{ await Html.RenderPartialAsync("_MigrationProgress", new MigrationProgressPanelViewModel(operationId, "cloneForm", "cloneButton", Model.FinishedMigration)); }
